/*------------------------

IF DB_ID('SheWay') IS NULL
BEGIN
    CREATE DATABASE SheWay;
END;
GO

USE SheWay;
GO

CREATE TABLE Kullanicilar (
    Kullanici_ID INT PRIMARY KEY IDENTITY(1,1),
    Ad_Soyad VARCHAR(100) NOT NULL,
    Telefon_No VARCHAR(15) UNIQUE NOT NULL,
    Acil_Durum_Tel VARCHAR(15) NOT NULL,
    Kayit_Tarihi DATETIME DEFAULT GETDATE()
);
GO

CREATE TABLE Guvenli_Noktalar (
    Nokta_ID INT PRIMARY KEY IDENTITY(1,1),
    Mekan_Adi VARCHAR(150) NOT NULL,
    Kategori VARCHAR(50),
    Enlem DECIMAL(10,8),
    Boylam DECIMAL(11,8),
    Acik_Saatler VARCHAR(50)
);
GO

CREATE TABLE Acil_Cagrilar (
    Cagri_ID INT PRIMARY KEY IDENTITY(1,1),
    Kullanici_ID INT NOT NULL,
    Basılma_Zamani DATETIME DEFAULT GETDATE(),
    Olay_Konumu VARCHAR(255),
    Durum VARCHAR(20) DEFAULT 'Bekliyor',

    FOREIGN KEY (Kullanici_ID)
        REFERENCES Kullanicilar(Kullanici_ID)
);
GO

CREATE TABLE Acil_Durum_Kisileri (
    Kisi_ID INT PRIMARY KEY IDENTITY(1,1),
    Kullanici_ID INT NOT NULL,
    Kisi_Adi VARCHAR(100) NOT NULL,
    Telefon_No VARCHAR(15) NOT NULL,
    Yakinlik_Derecesi VARCHAR(50),

    FOREIGN KEY (Kullanici_ID)
        REFERENCES Kullanicilar(Kullanici_ID)
        ON DELETE CASCADE
);
GO


CREATE TABLE Yolculuklar (
    Yolculuk_ID INT PRIMARY KEY IDENTITY(1,1),
    Kullanici_ID INT NOT NULL,
    Baslangic_Noktasi VARCHAR(255) NOT NULL,
    Varis_Noktasi VARCHAR(255) NOT NULL,
    Baslangic_Zamani DATETIME DEFAULT GETDATE(),
    Tahmini_Varis_Zamani DATETIME,
    Gercek_Varis_Zamani DATETIME,

    Yolculuk_Durumu VARCHAR(20) DEFAULT 'Planlandi'
        CHECK (
            Yolculuk_Durumu IN (
                'Planlandi',
                'Devam Ediyor',
                'Tamamlandi',
                'Iptal Edildi'
            )
        ),

    FOREIGN KEY (Kullanici_ID)
        REFERENCES Kullanicilar(Kullanici_ID)
        ON DELETE CASCADE
);
GO


CREATE TABLE Konum_Gecmisi (
    Konum_ID INT PRIMARY KEY IDENTITY(1,1),
    Yolculuk_ID INT NOT NULL,
    Enlem DECIMAL(10,7) NOT NULL,
    Boylam DECIMAL(10,7) NOT NULL,
    Kayit_Zamani DATETIME DEFAULT GETDATE(),

    FOREIGN KEY (Yolculuk_ID)
        REFERENCES Yolculuklar(Yolculuk_ID)
        ON DELETE CASCADE
);
GO


CREATE TABLE Acil_Durum_Bildirimleri (
    Bildirim_ID INT PRIMARY KEY IDENTITY(1,1),
    Kullanici_ID INT NOT NULL,
    Yolculuk_ID INT,
    Bildirim_Turu VARCHAR(50) NOT NULL,
    Bildirim_Mesaji VARCHAR(500),
    Bildirim_Zamani DATETIME DEFAULT GETDATE(),

    Bildirim_Durumu VARCHAR(20) DEFAULT 'Olusturuldu'
        CHECK (
            Bildirim_Durumu IN (
                'Olusturuldu',
                'Gonderildi',
                'Basarisiz'
            )
        ),

    FOREIGN KEY (Kullanici_ID)
        REFERENCES Kullanicilar(Kullanici_ID)
        ON DELETE CASCADE,

    FOREIGN KEY (Yolculuk_ID)
        REFERENCES Yolculuklar(Yolculuk_ID)
        ON DELETE SET NULL
);
GO


SELECT TABLE_NAME
FROM INFORMATION_SCHEMA.TABLES
WHERE TABLE_TYPE = 'BASE TABLE'
ORDER BY TABLE_NAME;
GO

